# =============================================================================
# BAUST Website — LOCAL Docker environment.
# Copy to `.env`, then:
#   docker compose -f compose.yml -f compose.local.yml up -d --build
#
# Everything here is a throwaway local value. Do NOT reuse it in production —
# for that, copy .env.docker.example instead and fill in real secrets.
# =============================================================================

APP_NAME=BAUST

# --- Local app settings (compose.local.yml also sets these) ---
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8086
LOG_LEVEL=debug
SESSION_SECURE_COOKIE=false

# Throwaway key for local containers only. Rotate for production with:
#   php artisan key:generate --show
APP_KEY=base64:5AHWBhLwqAd64MWyW3lyvfkwFLtw8F6h4JsxxGeOflk=

# --- Database (MySQL 8.4 container) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=baust_website
DB_USERNAME=baust_user
DB_PASSWORD=local_dev_password
MYSQL_ROOT_PASSWORD=local_root_password

# --- Laravel drivers ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail: log driver writes messages to storage/logs instead of sending ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@baust.edu.bd

# --- IQAC page admin (seeded iqac.admin@baust.edu.bd) ---
IQAC_ADMIN_PASSWORD=local_iqac_password

# --- Cloudflare Tunnel: unused locally, the tunnel service is not started ---
CLOUDFLARE_TUNNEL_TOKEN=
