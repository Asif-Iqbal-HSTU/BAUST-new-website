# =============================================================================
# BAUST Website - Docker Compose environment
# Copy to `.env` and fill in the secrets, then: docker compose up -d --build
# This file is read by compose.yml only. The application's runtime .env is
# generated inside the container by docker/entrypoint.sh from these values.
# =============================================================================

# --- Application ---
APP_NAME=BAUST
APP_ENV=production
APP_DEBUG=false
APP_URL=https://baust.edu.bd
# Generate once with: php artisan key:generate --show   (or: openssl rand -base64 32)
APP_KEY=base64:REPLACE_ME

# --- Database (MySQL 8.4) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=baust_website
DB_USERNAME=baust_user
DB_PASSWORD=REPLACE_ME
MYSQL_ROOT_PASSWORD=REPLACE_ME

# --- Laravel drivers ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail (defaults to log driver) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@baust.edu.bd

# --- Cloudflare Tunnel ---
# Token from: Zero Trust > Networks > Tunnels > (this tunnel) > Install connector.
# Configure the tunnel's Public Hostname `baust.edu.bd` (and `www.baust.edu.bd`) -> Service
# `http://baust_web_app:80` in the Cloudflare dashboard.
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ME

# --- IQAC page admin ---
# Initial password for the seeded iqac.admin@baust.edu.bd login (role: iqac_admin).
# If left unset, the seed migration generates a random one and prints it to the logs.
IQAC_ADMIN_PASSWORD=REPLACE_ME
